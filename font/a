<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<style>
  @font-face {
    font-family: 'Alfa Slab One';
    src: url('fonts/AlfaSlabOne-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  body { margin:0; font-family: sans-serif; }
  .box { padding: 60px 20px; text-align:center; }
  .blue { background:#4C7DF0; }
  .white { background:#fff; }
  .orange { background:#FF6B35; }
  .title-slab {
    font-family: 'Alfa Slab One', sans-serif;
    color: #FFD166;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 3rem;
    line-height: 1.1;
    text-shadow: 2px 2px 0 #E05525, 3px 3px 0 #E05525, 4px 4px 0 #E05525, 5px 5px 6px rgba(0,0,0,.25);
    -webkit-text-stroke: 1px #E05525;
    margin: 0;
  }
  .subtitle-slab {
    font-family: 'Alfa Slab One', sans-serif;
    color: #FFD166;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 1.3rem;
    text-shadow: 1px 1px 0 #E05525, 2px 2px 0 #E05525, 3px 3px 4px rgba(0,0,0,.2);
    -webkit-text-stroke: 0.5px #E05525;
    margin-top: 14px;
  }
  .subtitle-slab .dot { margin: 0 0.4em; opacity: .8; }
  .label { font-family: sans-serif; color:#888; margin-bottom:10px; font-size:13px; }
  /* Versione per sfondo chiaro: testo scuro, ombra chiara, niente stroke */
  .title-slab--onlight {
    color: #E05525;
    -webkit-text-stroke: 0;
    text-shadow: 2px 2px 0 #FFD166, 3px 3px 0 #FFD166, 4px 4px 6px rgba(0,0,0,.12);
  }
  .subtitle-slab--onlight {
    color: #E05525;
    -webkit-text-stroke: 0;
    text-shadow: 1px 1px 0 #FFD166, 2px 2px 4px rgba(0,0,0,.1);
  }
</style>
</head>
<body>

  <div class="box blue">
    <div class="label" style="color:#dbe6ff;">Su sfondo blu (come la foto originale)</div>
    <h1 class="title-slab">Lab Tecnologici</h1>
    <div class="subtitle-slab">Coding<span class="dot">•</span>Robotica<span class="dot">•</span>STEM</div>
  </div>

  <div class="box orange">
    <div class="label" style="color:#ffe3d3;">Su sfondo arancio (colore brand BITCODE)</div>
    <h1 class="title-slab">BitCode</h1>
    <div class="subtitle-slab">Coding<span class="dot">•</span>Robotica<span class="dot">•</span>STEM</div>
  </div>

  <div class="box white">
    <div class="label">Su sfondo bianco (versione alternativa, colori invertiti)</div>
    <h1 class="title-slab title-slab--onlight">BitCode</h1>
    <div class="subtitle-slab subtitle-slab--onlight">Coding<span class="dot">•</span>Robotica<span class="dot">•</span>STEM</div>
  </div>

</body>
</html>
